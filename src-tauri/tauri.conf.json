{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermiX",
  "version": "0.11.0",
  "identifier": "dev.termix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TermiX",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0c1017",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; script-src 'self'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform SSH and remote management client",
    "resources": { "windows/generated/termix-v3.ico": "termix-v3.ico", "windows/generated/THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt" },
    "windows": {
      "nsis": {
        "languages": ["English", "German"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/generated/header.bmp",
        "sidebarImage": "windows/generated/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "TermiX"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

